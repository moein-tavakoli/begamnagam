# LOCAL DEMO ONLY. Generate private local values: python3 scripts/init-local.py
# Compose keeps order delivery/payment simulated; real OTP has a separate opt-in.
DJANGO_SECRET_KEY=replace-with-generated-local-secret
PHONE_HASH_KEY=replace-with-generated-local-key
PHONE_ENCRYPTION_KEY=
POSTGRES_DB=begamnagam
POSTGRES_USER=begamnagam
POSTGRES_PASSWORD=replace-with-generated-local-password
RABBITMQ_USER=begamnagam
RABBITMQ_PASSWORD=replace-with-generated-local-password
WEB_PORT=3000
API_PORT=8000
DOCKER_SUBNET=10.253.241.0/24
APP_BASE_URL=http://localhost:3000
PRICE_TOMAN=2000
SENDER_DAILY_LIMIT=3
RECIPIENT_COOLDOWN_HOURS=168
# template: curated safe copy, no model required; ollama: local model rewrite
AI_MODE=template
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Kavenegar credentials: backend/worker only. Leave blank until configured.
# Adding a key does not activate real SMS in the local demo.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# sms uses ordinary SMS; lookup requires an approved OTP template.
KAVENEGAR_OTP_MODE=sms
KAVENEGAR_OTP_TEMPLATE=

# Real OTP only for an explicit local test; defaults never contact the provider.
OTP_BACKEND=demo
LOCAL_REAL_OTP_ENABLED=0
# HMAC-SHA256 of normalized test phone using PHONE_HASH_KEY; never a raw number.
OTP_TEST_RECIPIENT_HASHES=
# Conservative gross ceilings in integer RIAL, not vendor price estimates.
PROVIDER_DAILY_BUDGET_RIAL=0
OTP_MAX_COST_RIAL=0
