# LOCAL DEMO ONLY. Generate private local values: python3 scripts/init-local.py
# Compose keeps order delivery/payment simulated; real OTP has a separate opt-in.
DJANGO_SECRET_KEY=replace-with-generated-local-secret
PHONE_HASH_KEY=replace-with-generated-local-key
PHONE_ENCRYPTION_KEY=
POSTGRES_DB=begamnagam
POSTGRES_USER=begamnagam
POSTGRES_PASSWORD=replace-with-generated-local-password
RABBITMQ_USER=begamnagam
RABBITMQ_PASSWORD=replace-with-generated-local-password
WEB_PORT=3000
API_PORT=8000
DOCKER_SUBNET=10.253.241.0/24
APP_BASE_URL=http://localhost:3000
# Frontend build-time opt-in; local demo/private CT/staging must remain 0.
# Public release approval and a real public HTTPS APP_BASE_URL are required for 1.
SEO_INDEXABLE=0
PRICE_TOMAN=2000
SENDER_DAILY_LIMIT=5
RECIPIENT_COOLDOWN_HOURS=24
SENDER_RECIPIENT_COOLDOWN_HOURS=24
# Admin-only quota resets for simulated orders; never applies to OTP or live sends.
DEMO_TEST_TOOLS_ENABLED=0
# template: curated safe copy, no model required; ollama: local model rewrite
AI_MODE=template
# GapGPT opt-in: leave credentials empty until separately configured. Two bounded
# calls per rewrite (generation + verification); no silent template fallback.
GAPGPT_API_KEY=
GAPGPT_MODEL=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_TIMEOUT_SECONDS=5
GAPGPT_DAILY_REQUEST_LIMIT=0
GAPGPT_USER_DAILY_LIMIT=0
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Kavenegar credentials: backend/worker only. Leave blank until configured.
# Adding a key does not activate real SMS in the local demo.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
# sms uses ordinary SMS; lookup requires an approved OTP template.
KAVENEGAR_OTP_MODE=sms
KAVENEGAR_OTP_TEMPLATE=

# Explicit real OTP opt-in; any valid number can log in within rate/cost limits.
# Defaults never contact the provider; payments and order messages stay demo.
OTP_BACKEND=demo
# Outgoing order SMS defaults to pilot scope; live gift profile explicitly uses all.
SMS_RECIPIENT_POLICY=pilot
LOCAL_REAL_OTP_ENABLED=0
# Conservative gross ceilings in integer RIAL, not vendor price estimates.
PROVIDER_DAILY_BUDGET_RIAL=0
OTP_MAX_COST_RIAL=0
# Native macOS Python only, if its default CA store is missing:
# SSL_CERT_FILE=/etc/ssl/cert.pem
# Do not pass a host-only path into Docker; containers use their own CA store.
