{
    log {
        format filter {
            wrap json
            request delete
            resp_headers delete
        }
    }
}

{$APP_DOMAIN} {
    # No access log: SMS capability fragments never reach HTTP, and payment
    # callback query strings must not enter a reverse proxy access log.
    @api path /api/* /admin /admin/* /static/admin/* /healthz
    handle @api {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto https
            header_up -X-Forwarded-Host
        }
    }
    handle {
        reverse_proxy frontend:3000 {
            header_up X-Forwarded-Proto https
            header_up -X-Forwarded-Host
        }
    }
}
