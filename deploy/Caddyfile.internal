{
    admin off
    auto_https disable_redirects
    log {
        format filter {
            wrap json
            request delete
            resp_headers delete
        }
    }
}

http://{$INTERNAL_DEMO_HOST} {
    bind {$INTERNAL_DEMO_HOST}
    redir https://{$INTERNAL_DEMO_HOST}{uri} permanent
}

https://{$INTERNAL_DEMO_HOST} {
    bind {$INTERNAL_DEMO_HOST}
    tls internal
    @api path /api/* /admin /admin/* /static/admin/* /healthz
    handle @api {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto https
            header_up -X-Forwarded-Host
        }
    }
    handle {
        reverse_proxy frontend:3000 {
            header_up X-Forwarded-Proto https
            header_up -X-Forwarded-Host
        }
    }
}
