# Merge these non-secret overrides into the existing private .env.internal.
# The CT profile now uses Traefik and optional explicit domain routers.
PUBLIC_DEMO_HOST=begamnagam.ir
CENTRAL_NGINX_IP=192.168.1.6
TRUST_DOMAIN_PROXY=1
APP_BASE_URL=https://begamnagam.ir
ALLOWED_HOSTS=begamnagam.ir,192.168.1.123,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://begamnagam.ir,https://192.168.1.123
TRAEFIK_IMAGE=traefik:v3.7.13
INTERNAL_TLS_DIR=/opt/begamnagam/shared/traefik-tls
# Keep INTERNAL_DEMO_HOST, credentials, allowlists, budgets and provider modes.
