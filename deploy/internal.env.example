# Private CT demo; copy to ignored .env.internal with0600 permissions.
INTERNAL_DEMO_HOST=192.168.1.123
APP_BASE_URL=https://192.168.1.123
ALLOWED_HOSTS=192.168.1.123,backend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://192.168.1.123
BACKEND_IMAGE=begamnagam-internal/backend:0.8.10
FRONTEND_IMAGE=begamnagam-internal/frontend:0.8.10
PROXY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
RABBITMQ_IMAGE=rabbitmq:4.4-alpine
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
PHONE_HASH_KEY=REPLACE_WITH_STABLE_RANDOM_SECRET
PHONE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
POSTGRES_USER=begamnagam
POSTGRES_DB=begamnagam
POSTGRES_PASSWORD=REPLACE
RABBITMQ_USER=begamnagam
RABBITMQ_PASSWORD=REPLACE
DATABASE_URL=postgres://begamnagam:URL_ENCODED_PASSWORD@postgres:5432/begamnagam
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://begamnagam:URL_ENCODED_PASSWORD@rabbitmq:5672//
PRICE_TOMAN=2000
SENDER_DAILY_LIMIT=5
RECIPIENT_COOLDOWN_HOURS=24
SENDER_RECIPIENT_COOLDOWN_HOURS=24
DEMO_TEST_TOOLS_ENABLED=1
AI_MODE=template
SMS_BACKEND=console
PAYMENT_BACKEND=demo
PROVIDER_NETWORK_MODE=disabled
LIVE_PROVIDERS_ENABLED=0
# Only the previously authorized fixed OTP test may be enabled with its allowlist.
OTP_BACKEND=demo
LOCAL_REAL_OTP_ENABLED=0
OTP_TEST_RECIPIENT_HASHES=
PROVIDER_DAILY_BUDGET_RIAL=0
OTP_MAX_COST_RIAL=0
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_MODE=sms
KAVENEGAR_OTP_TEMPLATE=
