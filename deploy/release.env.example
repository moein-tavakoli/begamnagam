# Copy to ignored .env.release only after operator review. Never use sample secrets.
# Run Compose with --env-file .env.release -f compose.release.yaml (standalone).
APP_DOMAIN=begamnagam.ir
APP_BASE_URL=https://begamnagam.ir
# Build-time frontend settings: keep 0 until public release is approved and
# The canonical public origin is https://begamnagam.ir (without www).
# Pass both as Docker build args; runtime env alone does not update metadata.
SEO_INDEXABLE=0
ALLOWED_HOSTS=begamnagam.ir,backend
CSRF_TRUSTED_ORIGINS=https://begamnagam.ir
BACKEND_IMAGE=review-required@sha256:REPLACE
FRONTEND_IMAGE=review-required@sha256:REPLACE
PROXY_IMAGE=review-required@sha256:REPLACE
POSTGRES_IMAGE=review-required@sha256:REPLACE
REDIS_IMAGE=review-required@sha256:REPLACE
RABBITMQ_IMAGE=review-required@sha256:REPLACE
DJANGO_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
PHONE_HASH_KEY=REPLACE_WITH_STABLE_INDEPENDENT_RANDOM_SECRET
PHONE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
POSTGRES_USER=begamnagam
POSTGRES_DB=begamnagam
POSTGRES_PASSWORD=REPLACE
RABBITMQ_DEFAULT_USER=begamnagam
RABBITMQ_DEFAULT_PASS=REPLACE
DATABASE_URL=postgres://begamnagam:URL_ENCODED_PASSWORD@postgres:5432/begamnagam
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://begamnagam:URL_ENCODED_PASSWORD@rabbitmq:5672//
PROVIDER_NETWORK_MODE=disabled
LIVE_PROVIDERS_ENABLED=0
SMS_BACKEND=disabled
OTP_BACKEND=disabled
# Local OTP testing is unavailable in this non-demo release topology.
LOCAL_REAL_OTP_ENABLED=0
DEMO_TEST_TOOLS_ENABLED=0
SENDER_DAILY_LIMIT=5
RECIPIENT_COOLDOWN_HOURS=24
SENDER_RECIPIENT_COOLDOWN_HOURS=24
PAYMENT_BACKEND=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_MODE=sms
KAVENEGAR_OTP_TEMPLATE=
AI_MODE=template
# Optional GapGPT API: disabled until key, model and positive request caps are set.
GAPGPT_API_KEY=
GAPGPT_MODEL=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_TIMEOUT_SECONDS=5
GAPGPT_DAILY_REQUEST_LIMIT=0
GAPGPT_USER_DAILY_LIMIT=0
PROVIDER_DAILY_BUDGET_RIAL=0
SMS_MAX_COST_RIAL=0
OTP_MAX_COST_RIAL=0
PILOT_RECIPIENT_HASHES=
PILOT_POSITIVE_ONLY=1
SENDING_WINDOW_ENABLED=1
SENDING_START_HOUR=9
SENDING_END_HOUR=21
OPERATIONS_OWNER=
SUPPORT_CONTACT=
PROVIDER_CONTRACT_APPROVED=0
REFUND_PROCESS_APPROVED=0
TERMS_APPROVED=0
PRIVACY_POLICY_APPROVED=0
TERMS_VERSION=draft-2026-10
