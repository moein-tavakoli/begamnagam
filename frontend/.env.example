# This origin is private; browsers only call the same-origin /api/v1 proxy.
# Development: restart next dev after changes. Production: rebuild because
# rewrites are resolved at build time.
INTERNAL_API_URL=http://localhost:8000

# Copy this file to frontend/.env.local for native make dev-ui / npm run dev.
# The root Compose .env is not loaded by the native frontend automatically.
# These public SEO settings are also required when building a release image.
APP_BASE_URL=http://localhost:3000
# Keep demo, private CT and staging out of search. Enable only after public
# release approval and with the approved real public HTTPS origin above.
# Rebuild the frontend after changing either value in production.
SEO_INDEXABLE=0
