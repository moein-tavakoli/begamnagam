# Optional vendor configuration. These are examples, never activation approval.
# Keep the default app/demo working without this file. Load only on the backend.
PROVIDER_NETWORK_MODE=disabled
LIVE_PROVIDERS_ENABLED=0
PROVIDER_ENVIRONMENT=sandbox
PROVIDER_TIMEOUT_SECONDS=8
OTP_BACKEND=demo
SMS_BACKEND=console
PAYMENT_BACKEND=demo
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
KAVENEGAR_BASE_URL=https://api.kavenegar.com
ZARINPAL_MERCHANT_ID=
ZARINPAL_BASE_URL=https://sandbox.zarinpal.com
ZARINPAL_REDIRECT_BASE=https://sandbox.zarinpal.com
# Money in these three variables is integer RIAL, not the sale price in toman.
PROVIDER_DAILY_BUDGET_RIAL=0
SMS_MAX_COST_RIAL=0
OTP_MAX_COST_RIAL=0
# HMAC hashes only; no raw phone list in repository or frontend.
PILOT_RECIPIENT_HASHES=
OPERATIONS_OWNER=
PROVIDER_CONTRACT_APPROVED=0
REFUND_PROCESS_APPROVED=0

# Safety/operating prerequisites; no names or approval are invented.
SUPPORT_CONTACT=
TERMS_APPROVED=0
PRIVACY_POLICY_APPROVED=0
SENDING_WINDOW_ENABLED=1
SENDING_START_HOUR=9
SENDING_END_HOUR=21
PILOT_POSITIVE_ONLY=1
PHONE_ENCRYPTION_FALLBACK_KEYS=
